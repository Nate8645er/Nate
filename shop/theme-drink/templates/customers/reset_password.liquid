<section class="ld-seite"><div class="ld-breite ld-breite--eng">
  <header class="ld-kopfzeile"><h1 class="ld-riese ld-riese--mittel">Neues Passwort</h1></header>
  {%- form 'reset_customer_password', class: 'ld-form' -%}
    {%- if form.errors -%}<p class="ld-meldung ld-meldung--fehler">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label class="ld-feld"><span>Neues Passwort</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <label class="ld-feld"><span>Wiederholen</span><input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
    <button class="ld-knopf ld-knopf--gross" type="submit">Speichern</button>
  {%- endform -%}
</div></section>
