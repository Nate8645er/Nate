<section class="ld-seite"><div class="ld-breite ld-breite--eng">
  <header class="ld-kopfzeile"><h1 class="ld-riese ld-riese--mittel">Konto anlegen</h1></header>
  {%- form 'create_customer', class: 'ld-form' -%}
    {%- if form.errors -%}<p class="ld-meldung ld-meldung--fehler">{{ form.errors | default_errors }}</p>{%- endif -%}
    <div class="ld-form__paar">
      <label class="ld-feld"><span>Vorname</span><input type="text" name="customer[first_name]" autocomplete="given-name"></label>
      <label class="ld-feld"><span>Nachname</span><input type="text" name="customer[last_name]" autocomplete="family-name"></label>
    </div>
    <label class="ld-feld"><span>E-Mail</span><input type="email" name="customer[email]" autocomplete="email" required></label>
    <label class="ld-feld"><span>Passwort</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <button class="ld-knopf ld-knopf--gross" type="submit">Konto anlegen</button>
  {%- endform -%}
</div></section>
