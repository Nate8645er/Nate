<section class="ld-seite"><div class="ld-breite ld-breite--eng">
  <header class="ld-kopfzeile"><h1 class="ld-riese ld-riese--mittel">Konto aktivieren</h1></header>
  {%- form 'activate_customer_password', class: 'ld-form' -%}
    {%- if form.errors -%}<p class="ld-meldung ld-meldung--fehler">{{ form.errors | default_errors }}</p>{%- endif -%}
    <label class="ld-feld"><span>Passwort</span><input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <label class="ld-feld"><span>Wiederholen</span><input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
    <button class="ld-knopf ld-knopf--gross" type="submit">Aktivieren</button>
    <p class="ld-form__klein"><button class="ld-geist ld-geist--dunkel" type="submit" name="decline">Einladung ablehnen</button></p>
  {%- endform -%}
</div></section>
