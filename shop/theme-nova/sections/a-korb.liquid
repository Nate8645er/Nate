{%- comment -%}
  sections/a-korb.liquid — LET'SDRINK AMBER, Warenkorb
  9.8.2026. Bauleitung.

  Kein JavaScript. Menge aendern und Zeile entfernen laufen ueber das
  Formular beziehungsweise ueber /cart/change - beides funktioniert
  ohne Skript, auch mit Skriptblocker.

  ROTE LINIEN: keine Verknappung ("nur noch 2 auf Lager"), kein
  Zaehler, kein Hinweis auf einen Betrag, ab dem der Versand gratis
  wuerde - in der Schweiz ist er ohnehin immer gratis, und in die
  uebrigen Laender kostet er immer CHF 1.50.
{%- endcomment -%}

{%- assign farben = 'tuerkis,gruen,rosa,grau,schwarz,weiss' | split: ',' -%}

<div class="a-seite">
  <div class="a-huelle">

    {%- comment -%}
      Derselbe Kopf wie auf den Inhaltsseiten, in der Fassung mit dem
      Tropfen der Wortmarke statt eines Fotos. Vorher stand hier eine
      Ueberschrift auf Weiss, waehrend Frageseite, Versand und Kontakt
      laengst einen Kopf tragen - die Seiten sahen aus, als gehoerten
      sie nicht zusammen.

      KEIN Produktfoto auf diesen drei Seiten: Warenkorb, Suche und
      Liste sind Arbeitsseiten. Wer hier steht, sucht oder rechnet;
      eine Flasche daneben waere ein Verkaufsversuch an einer Stelle,
      an der die Entscheidung schon gefallen ist. Dieselbe
      Ueberlegung wie bei den Rechtsseiten.
    {%- endcomment -%}
    <header class="a-schild a-schild--bild a-schild--marke">
      <div class="a-schild__text">
        <p class="a-auge">Let&rsquo;sDrink</p>
        <h1 class="a-titel">Warenkorb</h1>
      </div>
      <span class="a-schild__marke" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 3.2C9 7.4 6.2 10.2 6.2 13.8a5.8 5.8 0 0 0 11.6 0c0-3.6-2.8-6.4-5.8-10.6Z"/>
        </svg>
      </span>
    </header>

    {%- if cart.item_count == 0 -%}

      <div class="a-leer">
        <p>Dein Warenkorb ist leer.</p>
        <p style="margin-bottom:1.8rem">
          Es gibt genau ein Produkt in diesem Shop: die Trinkflasche mit fest
          angebautem Napf, 550 ml, in sechs Farben.
        </p>
        <a class="a-knopf a-knopf--schmal" href="{{ routes.root_url }}">Zur Flasche</a>
      </div>

    {%- else -%}

      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <div class="a-korb">

          <div>
            {%- for item in cart.items -%}
              {%- liquid
                assign s = item.variant.option1 | replace: 'ü','ue' | replace: 'Ü','Ue' | replace: 'ä','ae' | replace: 'ö','oe' | downcase
                assign eigen = false
                if farben contains s
                  assign eigen = true
                endif
              -%}
              <div class="a-pos">
                <div class="a-pos__bild">
                  {%- if eigen -%}
                    <img src="{{ 'a-flasche-' | append: s | append: '.webp' | asset_url }}"
                         alt="" width="650" height="2212" loading="lazy" decoding="async">
                  {%- elsif item.image -%}
                    <img src="{{ item.image | image_url: height: 180 }}" alt=""
                         width="90" height="180" loading="lazy" decoding="async">
                  {%- endif -%}
                </div>

                <div>
                  <p class="a-pos__name">
                    <a href="{{ item.url }}" style="text-decoration:none">{{ item.product.title }}</a>
                  </p>
                  <p class="a-pos__var">
                    {%- unless item.product.has_only_default_variant -%}
                      {{ item.variant.title }} ·
                    {%- endunless -%}
                    {%- comment -%}
                      Hier stand item.original_price, also der
                      Katalogpreis CHF 39.90. Drei Zentimeter darunter
                      steht die Zeilensumme aus final_line_price, bei
                      einer Flasche CHF 37.91. Zwei verschiedene Preise
                      fuer dasselbe Stueck im selben Kasten.
                    {%- endcomment -%}
                    {{ item.final_price | money }} pro Stück
                  </p>

                  <div class="a-pos__fuss">
                    <label>
                      <span class="a-sr">Menge für {{ item.product.title }}</span>
                      <input type="number" name="updates[{{ item.key }}]"
                             value="{{ item.quantity }}" min="0" step="1" inputmode="numeric">
                    </label>
                    <a class="a-weg" href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">
                      Entfernen
                    </a>
                    <span class="a-pos__preis">{{ item.final_line_price | money }}</span>
                  </div>
                </div>
              </div>
            {%- endfor -%}

            <label class="a-sr" for="a-notiz">Nachricht zur Bestellung</label>
            <textarea class="a-notiz" id="a-notiz" name="note"
                      placeholder="Etwas, das ich zu deiner Bestellung wissen sollte? (freiwillig)">{{ cart.note }}</textarea>

            <p style="margin-top:1rem">
              <button class="a-weg" type="submit" name="update">Mengen aktualisieren</button>
            </p>
          </div>

          <div class="a-summe">
            <div class="a-summe__zeile">
              <span>Zwischensumme</span>
              <span>{{ cart.items_subtotal_price | money }}</span>
            </div>
            <div class="a-summe__zeile">
              <span>Versand Schweiz</span>
              <span>gratis</span>
            </div>

            <div class="a-summe__gesamt">
              <span>Total</span>
              <span>{{ cart.total_price | money }}</span>
            </div>
            <p class="a-summe__hinweis">
              Endpreis. In die übrigen Länder kommen CHF 1.50 Versand dazu.
              Der endgültige Betrag steht im nächsten Schritt, bevor du bezahlst.
            </p>

            <button class="a-knopf" type="submit" name="checkout">Zur Kasse</button>

            <ul class="a-sicher">
              <li>14 Tage Rückgabe</li>
              <li>7–14 Werktage</li>
            </ul>
          </div>

        </div>
      </form>

    {%- endif -%}

    <div class="a-weiter">
      <a href="/pages/versand-und-rueckgabe">Versand &amp; Rückgabe</a>
      <a href="/pages/haeufige-fragen">Häufige Fragen</a>
      <a href="/pages/contact">Kontakt</a>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Amber Warenkorb",
  "settings": [],
  "presets": [{ "name": "Amber Warenkorb" }]
}
{% endschema %}
