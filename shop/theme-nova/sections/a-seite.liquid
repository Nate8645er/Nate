{%- comment -%}
  sections/a-seite.liquid — Inhaltsseiten
  Impressum, AGB, Datenschutz, Versand & Rueckgabe, Haeufige Fragen,
  Ueber uns. Der Text kommt aus dem Shopify-Seiteninhalt und wird hier
  nur gesetzt, nicht umgeschrieben - rechtliche Texte gehoeren dem
  Inhaber, nicht dem Theme.

  EINE AUSNAHME: die Seite "Haeufige Fragen" hatte ihre eigene Fassung
  der Antworten, die von der im Shop abwich - andere Formulierung,
  teils andere Aussage. Sie rendert jetzt dieselbe Quelle wie der
  Frageblock der Startseite und der Chat. Im Seiteninhalt bleibt nur,
  was dort NICHT steht.
{%- endcomment -%}

<div class="a-seite">
  <div class="a-huelle">

    <div class="a-kopfzeile">
      <p class="a-auge">Let&rsquo;sDrink</p>
      <h1 class="a-titel">{{ page.title }}</h1>
    </div>

    {%- if page.handle == 'haeufige-fragen' -%}
      <div class="a-text">{% render 'n-wissen' %}</div>
      {%- if page.content != blank -%}
        <div class="a-text a-text--nach">{{ page.content }}</div>
      {%- endif -%}
    {%- else -%}
      <div class="a-text">
        {{ page.content }}
      </div>
    {%- endif -%}

    <div class="a-weiter">
      <a href="{{ routes.root_url }}">Zur Flasche</a>
      <a href="/pages/versand-und-rueckgabe">Versand &amp; Rückgabe</a>
      <a href="/pages/haeufige-fragen">Häufige Fragen</a>
      <a href="/pages/contact">Kontakt</a>
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Amber Seite",
  "settings": [],
  "presets": [{ "name": "Amber Seite" }]
}
{% endschema %}
