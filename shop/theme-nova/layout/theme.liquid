  {{ 'n-nova.css' | asset_url | stylesheet_tag }}

  {%- comment -%}
    Rund 6 KB eigenes Skript, keine Bibliothek von aussen. Kein GSAP,
    kein Lenis, kein Framer Motion - die Bewegung laeuft ueber
    CSS-Transitions, einen IntersectionObserver und genau eine
    rAF-Schleife fuer die Parallaxe.
  {%- endcomment -%}
  <script src="{{ 'n-nova.js' | asset_url }}" defer></script>

  {%- if ist_start -%}
  {%- comment -%}
    Der Intro-Vorhang muss VOR dem ersten Bild entschieden werden -
    sonst blitzt der Laden kurz auf, bevor der Vorhang faellt. Darum
    steht das hier inline und synchron und nicht im aufgeschobenen
    Skript. Drei Bedingungen, sonst laeuft er nicht: Startseite,
    keine Bewegungsreduktion, noch nicht in dieser Sitzung gesehen.
  {%- endcomment -%}
  <script>
    (function () {
      var w = window, d = document;
      try {
        if (w.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        if (sessionStorage.getItem("n-vorhang")) return;
        /* SOFORT merken, nicht erst wenn sich der Vorhang hebt.
           Gemessen: faellt n-nova.js aus, wurde der Schluessel nie
           gesetzt - die schwarze Flaeche erschien bei JEDEM Aufruf der
           Startseite neu. */
        sessionStorage.setItem("n-vorhang", "1");
      } catch (e) { return; }
      d.documentElement.classList.add("n-intro");

      /* Die Notausgaenge gehoeren hierher, nicht ins aufgeschobene
         Skript. Gemessen: ohne n-nova.js wirkte weder Escape noch
         Klick noch Mausrad noch der Ueberspringen-Knopf - man sass
         volle vier Sekunden vor Schwarz. */
      var weg = function () {
        d.documentElement.classList.remove("n-intro");
        d.removeEventListener("keydown", taste, true);
        d.removeEventListener("click", weg, true);
        w.removeEventListener("wheel", weg, true);
        w.removeEventListener("touchmove", weg, true);
      };
      var taste = function (e) {
        if (e.key === "Escape" || e.key === "Enter" || e.key === " ") weg();
      };
      d.addEventListener("keydown", taste, true);
      d.addEventListener("click", weg, true);
      w.addEventListener("wheel", weg, { capture: true, passive: true });
      w.addEventListener("touchmove", weg, { capture: true, passive: true });
      w.setTimeout(weg, 4000);   // harte Obergrenze
    })();
  </script>
  {%- endif -%}

  {{ content_for_header }}
</head>
