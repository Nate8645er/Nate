  {%- liquid
    assign ist_start = false
    if template.name == 'index'
      assign ist_start = true
    endif
    assign lp = all_products['trinkflasche-napf-hund-katze']
    assign lv = lp.selected_or_first_available_variant
    assign kauf_hier = false
    if ist_start or template.name == 'product'
      assign kauf_hier = true
    endif
    assign kaufziel = routes.root_url
    if lp != empty
      assign kaufziel = lp.url
    endif
    if kauf_hier
      assign kaufziel = '#kaufen'
    endif
  -%}

