# Platform Backend (Produkt A) — Konfiguration.
# Nach .env kopieren und ausfuellen. .env ist in .gitignore und wird NIE committet.
# Keine bekannten Default-Werte im Compose: fehlt eine Pflicht-Variable,
# schlaegt der Start bewusst fehl (fail-closed).

# --- Datenbank ---
# Superuser fuer Migrationen (DDL + Rollen/Grants).
POSTGRES_PASSWORD=
# Passwort der eingeschraenkten Laufzeit-Rolle app_rw (RLS-gebunden).
APP_DB_PASSWORD=
#
# Fuer Betrieb OHNE Compose (z.B. gegen Supabase) direkt setzen:
#   DATABASE_URL         = Laufzeit-Rolle (NOSUPERUSER, NOBYPASSRLS, nicht Owner)
#   MIGRATE_DATABASE_URL = privilegierte Rolle fuer Migrationen
# DATABASE_URL=postgresql://app_rw:...@host:5432/platform
# MIGRATE_DATABASE_URL=postgresql://postgres:...@host:5432/platform

# --- LiteLLM-Gateway ---
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=

# --- KI-Team ueber OpenRouter (EIN Key fuer 13 Anbieter) ---
# Schaltet die openrouter/*-Modelle in litellm/config.yaml frei und wird von
# ops/council.py + ops/council_check.py genutzt. Key: openrouter.ai -> Keys.
OPENROUTER_API_KEY=

# --- MuAPI (Creative-Pipeline, Produkt C: Bild/Video/Audio) ---
# Ergaenzt die selbst gebaute SVG-/Remotion-Pipeline. Key: muapi.ai.
MUAPI_API_KEY=

# --- Modell-Anbieter direkt (nur setzen, was der Tarif-Katalog nutzt) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Provisionierung/Admin ---
# Schuetzt POST /admin/provision. Langen Zufallswert waehlen.
ADMIN_TOKEN=

# --- Store-Webhook (Produkt B) ---
# Shopify Webhook Signing Secret; verifiziert POST /webhooks/shopify/orders-paid.
SHOPIFY_WEBHOOK_SECRET=

# --- Abrechnung / Stripe (Phase 4) ---
# Signing Secret des Stripe-Webhook-Endpunkts (whsec_...); verifiziert
# POST /webhooks/stripe inkl. Zeitfenster gegen Replay.
STRIPE_WEBHOOK_SECRET=
# Optional: Zuordnung Stripe-Preis -> Tarif, falls die Preise keine
# metadata.plan_code tragen. Format: price_123:pro,price_456:business
STRIPE_PRICE_MAP=

# --- Betrieb ---
AUTO_MIGRATE=false
CORS_ORIGINS=
REQUEST_TIMEOUT_S=120

# --- Rate-Limiting bei mehr als einem Backend-Prozess/Pod ---
# Leer = In-Process-Limiter (Standard, reicht fuer einen einzelnen Prozess).
# Gesetzt = Redis-backed, damit alle Prozesse/Pods sich einen Zaehler teilen.
# REDIS_URL=redis://localhost:6379/0

# --- Composio (echter OAuth-Flow fuer /v1/integrations) ---
# Leer = Geruest-Verhalten wie bisher (status bleibt immer 'disconnected').
# Gesetzt = /v1/integrations initiiert eine echte Verbindung ueber Composio
# und liefert eine echte Login-URL zurueck. Key: composio.dev -> Settings -> API Keys.
# COMPOSIO_API_KEY=

# --- Stripe: nutzungsbasierte Abrechnung (Billing-Meters-API) ---
# Leer = keine Meldung an Stripe (kein Fehler, Verbrauch bleibt nur lokal in
# usage_events/GET /v1/usage sichtbar). Gesetzt = jeder abgeschlossene
# Chat-Aufruf meldet seinen Token-Verbrauch als Meter-Event an Stripe, sofern
# der Mandant einen verknuepften stripe_customer_id hat (siehe billing.py).
# Getrennter Key von STRIPE_WEBHOOK_SECRET (der verifiziert nur eingehende
# Webhooks, dieser hier ruft Stripes API auf). Secret Key aus dem Stripe-
# Dashboard, Meter mit event_name "platform_tokens" muss dort angelegt sein.
# STRIPE_SECRET_KEY=
