{%- comment -%}
  FAQ (Produkt B). Reine <details>/<summary>-Akkordeons, kein JS noetig.
  Bearbeitbar im Theme-Editor ueber Bloecke (ein Block = eine Frage).
{%- endcomment -%}

<section class="faq" style="background:#0b0d12;color:#e7ebf3;padding:64px 20px;">
  <div style="max-width:760px;margin:0 auto;">
    <h2 style="font-size:32px;font-weight:700;margin:0 0 32px;text-align:center;">
      {{ section.settings.heading | escape }}
    </h2>

    <div style="display:flex;flex-direction:column;gap:10px;">
      {%- for block in section.blocks -%}
        <details {{ block.shopify_attributes }}
                  style="background:#12151d;border:1px solid #232838;border-radius:12px;padding:6px 18px;">
          <summary style="cursor:pointer;padding:12px 0;font-weight:600;font-size:15.5px;">
            {{ block.settings.question | escape }}
          </summary>
          <p style="color:#8b93a7;margin:0 0 16px;font-size:14.5px;line-height:1.6;">
            {{ block.settings.answer | escape }}
          </p>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Häufige Fragen" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage" },
        { "type": "textarea", "id": "answer", "label": "Antwort" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "question", "settings": { "question": "Kann ich jederzeit kündigen?", "answer": "Ja. Alle Abos sind monatlich kündbar, ohne Mindestlaufzeit. Nach der Kündigung läuft das Konto bis zum Ende der bezahlten Periode weiter." } },
        { "type": "question", "settings": { "question": "Muss ich einen API-Key von OpenAI oder Anthropic mitbringen?", "answer": "Nein. Alle Modelle sind bereits im Abo enthalten — du bezahlst einen Tarif und wählst das Modell direkt in der Plattform, ohne eigene Anbieter-Konten." } },
        { "type": "question", "settings": { "question": "Was passiert nach dem Kauf?", "answer": "Du wirst automatisch angemeldet und landest direkt im Chat — kein Key kopieren, kein Einrichten." } },
        { "type": "question", "settings": { "question": "Wo werden meine Daten gespeichert?", "answer": "Jeder Kunde ist auf Datenbankebene strikt von anderen Kunden getrennt (Row-Level-Security). Details zur Datenverarbeitung stehen in der Datenschutzerklärung." } },
        { "type": "question", "settings": { "question": "Kann ich den Tarif wechseln?", "answer": "Ja, jederzeit im Kundenkonto — der neue Tarif gilt ab der nächsten Abrechnungsperiode." } },
        { "type": "question", "settings": { "question": "Gibt es einen kostenlosen Test?", "answer": "Ja, der Free-Tarif ist dauerhaft kostenlos nutzbar (mit einem lokalen Modell und begrenztem Kontingent) — keine Kreditkarte nötig." } }
      ]
    }
  ]
}
{% endschema %}
