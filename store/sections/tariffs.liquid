{%- comment -%}
  Tarif-Vergleich (Produkt B). Ehrlich nach Schweizer Recht (UWG/PBV):
  - Preise in CHF inkl. MwSt, klar ausgewiesen.
  - Keine Fake-Verknappung, keine erfundenen Bewertungen, keine Streichpreise.
  Bearbeitbar im Theme-Editor ueber Bloecke (ein Block = ein Tarif).

  Visuelle Hierarchie: eine 5-Balken-Stufenanzeige zeigt die Position eines
  Tarifs in der Leiter (aus der Block-Reihenfolge berechnet, kein neues
  Schema-Feld noetig), und der hervorgehobene Tarif bekommt ein "Beliebt"-
  Badge in der Signalfarbe (--signal, sonst nur im Logo genutzt) statt eines
  zusaetzlichen Glow-Effekts.
{%- endcomment -%}

<section class="tariffs" style="background:#07080d;color:#eef0f7;padding:64px 20px;">
  <div style="max-width:1100px;margin:0 auto;">
    <h2 class="brand-font" style="font-size:clamp(26px,3.5vw,36px);font-weight:700;margin:0 0 8px;text-align:center;letter-spacing:-0.01em;">
      {{ section.settings.heading | escape }}
    </h2>
    <p style="color:#8b93ab;text-align:center;margin:0 0 40px;">
      {{ section.settings.subheading | escape }}
    </p>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:18px;">
      {%- for block in section.blocks -%}
        {%- assign tier_level = forloop.index -%}
        {%- if tier_level > 5 -%}{%- assign tier_level = 5 -%}{%- endif -%}
        <div {{ block.shopify_attributes }}
             style="background:#12151f;border:{% if block.settings.highlight %}2px{% else %}1px{% endif %} solid {% if block.settings.highlight %}#7c8bfa{% else %}#242a3d{% endif %};border-radius:14px;padding:22px;display:flex;flex-direction:column;{% if block.settings.highlight %}box-shadow:0 8px 24px -12px rgba(124,139,250,0.45);{% endif %}">

          <div aria-hidden="true" style="display:flex;align-items:flex-end;gap:3px;height:15px;margin-bottom:12px;">
            {%- for i in (1..5) -%}
              <span style="display:block;width:4px;height:{{ i | times: 2 | plus: 5 }}px;border-radius:1.5px;background:{% if i <= tier_level %}{% if block.settings.highlight %}#3fe3c4{% else %}#7c8bfa{% endif %}{% else %}#242a3d{% endif %};"></span>
            {%- endfor -%}
          </div>

          {%- if block.settings.highlight -%}
            <span style="display:inline-block;background:rgba(63,227,196,0.12);color:#3fe3c4;border:1px solid rgba(63,227,196,0.35);font-size:11px;font-weight:600;letter-spacing:0.02em;padding:3px 9px;border-radius:20px;margin-bottom:10px;width:fit-content;">
              Beliebt
            </span>
          {%- endif -%}

          <h3 class="brand-font" style="margin:0 0 4px;font-size:21px;letter-spacing:-0.01em;">{{ block.settings.name | escape }}</h3>
          <p style="color:#8b93ab;margin:0 0 14px;font-size:13px;">{{ block.settings.audience | escape }}</p>
          <p style="font-size:26px;font-weight:700;color:#7c8bfa;margin:0;">{{ block.settings.price | escape }}</p>
          <p style="color:#8b93ab;font-size:12px;margin:2px 0 16px;">inkl. MwSt</p>
          <ul style="list-style:none;padding:0;margin:0 0 20px;flex:1;">
            {%- assign feats = block.settings.features | newline_to_br | split: '<br />' -%}
            {%- for f in feats -%}
              {%- assign t = f | strip -%}
              {%- if t != '' -%}
                <li style="padding:6px 0;border-bottom:1px solid #1b2030;font-size:14px;">{{ t | escape }}</li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
          {%- if block.settings.cta_url != blank -%}
            <a href="{{ block.settings.cta_url }}"
               style="text-align:center;background:#4c56b0;color:#fff;text-decoration:none;font-weight:600;padding:11px;border-radius:9px;">
              {{ block.settings.cta_label | default: 'Auswählen' | escape }}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tarife",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Tarife" },
    { "type": "text", "id": "subheading", "label": "Unterzeile", "default": "Ehrlicher Vergleich — Preise in CHF inkl. MwSt." }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Tarif",
      "settings": [
        { "type": "text", "id": "name", "label": "Name", "default": "Pro" },
        { "type": "text", "id": "audience", "label": "Zielgruppe", "default": "KMU" },
        { "type": "text", "id": "price", "label": "Preis (CHF inkl. MwSt)", "default": "CHF 49.00 / Monat" },
        { "type": "textarea", "id": "features", "label": "Funktionen (eine pro Zeile)", "default": "Starke Cloud- + lokale Modelle\n10 Agenten\n10 Mio. Tokens/Monat\n3 Integrationen" },
        { "type": "checkbox", "id": "highlight", "label": "Hervorheben", "default": false },
        { "type": "url", "id": "cta_url", "label": "Button-Link" },
        { "type": "text", "id": "cta_label", "label": "Button-Text", "default": "Auswählen" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Tarife",
      "blocks": [
        { "type": "plan", "settings": { "name": "Free", "audience": "Zum Testen", "price": "Kostenlos", "features": "1 lokales Modell\n1 Agent\n100'000 Tokens/Monat\nKein Support", "cta_url": "/products/ki-plattform-abo-free", "cta_label": "Kostenlos starten" } },
        { "type": "plan", "settings": { "name": "Starter", "audience": "Einzelunternehmer", "price": "CHF 19.00 / Monat", "features": "Schnelle Cloud-Modelle\n3 Agenten\n2 Mio. Tokens/Monat\nE-Mail-Support", "cta_url": "/products/ki-plattform-abo-starter" } },
        { "type": "plan", "settings": { "name": "Pro", "audience": "KMU", "price": "CHF 49.00 / Monat", "highlight": true, "features": "Starke Cloud- + lokale Modelle\n10 Agenten\n10 Mio. Tokens/Monat\n3 Integrationen", "cta_url": "/products/ki-plattform-abo-pro" } },
        { "type": "plan", "settings": { "name": "Business", "audience": "Teams", "price": "CHF 149.00 / Monat", "features": "Alle Modelle, freie Wahl\n30 Agenten\n50 Mio. Tokens/Monat\nSSO + Team-Verwaltung", "cta_url": "/products/ki-plattform-abo-business" } },
        { "type": "plan", "settings": { "name": "Enterprise", "audience": "Konzern / Individuell", "price": "Auf Anfrage", "features": "Alles + dedizierte Instanz\nUnbegrenzte Agenten\nSLA + Onboarding\nEigener Mandant" } }
      ]
    }
  ]
}
{% endschema %}
