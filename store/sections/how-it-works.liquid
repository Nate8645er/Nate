{%- comment -%}
  "Wie es funktioniert" (Produkt B). Erklaert WAS die Plattform ist, WIE der
  Ablauf vom Kauf bis zum ersten Chat aussieht und WARUM sie existiert --
  ergaenzt die knappen FAQ-Antworten und Tarif-/Funktionen-Kacheln um eine
  zusammenhaengende Erklaerung. Nur Fakten, die anderswo im Repo gedeckt sind
  (siehe platform-backend/README.md), keine erfundenen Zahlen.

  Bearbeitbar im Theme-Editor ueber Bloecke: "step" (Ablaufschritte, WIE) und
  "value" (Wert-Argumente, WARUM) leben in derselben Blockliste wie bei
  main-product/features -- ein Block-Typ pro wiederkehrendem Element, WAS
  bleibt als Freitext-Einstellung, weil es kein wiederholtes Element ist.

  Farben/Fonts identisch zu features.liquid/tariffs.liquid uebernommen
  (kein neuer Hex-Wert), --signal nur als Aufmerksamkeitsmarker fuer die
  drei Abschnittsnummern, wie im Tarif-"Beliebt"-Badge.
{%- endcomment -%}

<section class="how-it-works" style="background:#07080d;color:#eef0f7;padding:64px 20px;">
  <div style="max-width:820px;margin:0 auto;">
    <h1 class="brand-font" style="font-size:clamp(30px,4.5vw,44px);font-weight:700;margin:0 0 12px;text-align:center;letter-spacing:-0.02em;line-height:1.15;text-wrap:balance;">
      {{ section.settings.heading | escape }}
    </h1>
    <p style="color:#8b93ab;text-align:center;margin:0 0 32px;font-size:16px;line-height:1.6;max-width:560px;margin-left:auto;margin-right:auto;">
      {{ section.settings.subheading | escape }}
    </p>

    <nav aria-label="Abschnitte" style="display:flex;justify-content:center;gap:20px;margin:0 0 56px;flex-wrap:wrap;">
      <a href="#was" style="color:#8b93ab;text-decoration:none;font-size:13.5px;border-bottom:1px solid #242a3d;padding-bottom:2px;">Was</a>
      <a href="#wie" style="color:#8b93ab;text-decoration:none;font-size:13.5px;border-bottom:1px solid #242a3d;padding-bottom:2px;">Wie</a>
      <a href="#warum" style="color:#8b93ab;text-decoration:none;font-size:13.5px;border-bottom:1px solid #242a3d;padding-bottom:2px;">Warum</a>
    </nav>

    {%- comment -%} WAS {%- endcomment -%}
    <div id="was" style="margin:0 0 64px;scroll-margin-top:24px;">
      <span class="brand-font" style="color:#3fe3c4;font-size:13px;font-weight:700;letter-spacing:0.06em;">01 — WAS</span>
      <h2 class="brand-font" style="font-size:clamp(22px,3vw,28px);font-weight:700;margin:8px 0 14px;letter-spacing:-0.01em;">
        {{ section.settings.was_heading | escape }}
      </h2>
      <p style="color:#c3c9d6;font-size:16px;line-height:1.7;margin:0;">
        {{ section.settings.was_text | escape }}
      </p>
    </div>

    {%- comment -%} WIE {%- endcomment -%}
    <div id="wie" style="margin:0 0 64px;scroll-margin-top:24px;">
      <span class="brand-font" style="color:#3fe3c4;font-size:13px;font-weight:700;letter-spacing:0.06em;">02 — WIE</span>
      <h2 class="brand-font" style="font-size:clamp(22px,3vw,28px);font-weight:700;margin:8px 0 24px;letter-spacing:-0.01em;">
        {{ section.settings.wie_heading | escape }}
      </h2>

      <div style="display:flex;flex-direction:column;">
        {%- assign step_count = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_count = step_count | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}

        {%- assign step_index = 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'step' -%}
            {%- assign step_index = step_index | plus: 1 -%}
            <div {{ block.shopify_attributes }} style="display:flex;gap:16px;">
              <div style="display:flex;flex-direction:column;align-items:center;flex-shrink:0;">
                <span aria-hidden="true" style="width:32px;height:32px;border-radius:50%;background:#12151f;border:1px solid #242a3d;color:#7c8bfa;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13.5px;">
                  {{ step_index }}
                </span>
                {%- if step_index < step_count -%}
                  <span aria-hidden="true" style="width:1px;flex:1;min-height:24px;background:#242a3d;margin:4px 0;"></span>
                {%- endif -%}
              </div>
              <div style="padding-bottom:28px;">
                <h3 style="margin:4px 0 6px;font-size:16.5px;font-weight:600;">{{ block.settings.title | escape }}</h3>
                <p style="color:#8b93ab;margin:0;font-size:14.5px;line-height:1.6;">{{ block.settings.text | escape }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- comment -%} WARUM {%- endcomment -%}
    <div id="warum" style="scroll-margin-top:24px;">
      <span class="brand-font" style="color:#3fe3c4;font-size:13px;font-weight:700;letter-spacing:0.06em;">03 — WARUM</span>
      <h2 class="brand-font" style="font-size:clamp(22px,3vw,28px);font-weight:700;margin:8px 0 24px;letter-spacing:-0.01em;">
        {{ section.settings.warum_heading | escape }}
      </h2>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:16px;">
        {%- for block in section.blocks -%}
          {%- if block.type == 'value' -%}
            <div {{ block.shopify_attributes }} style="background:#12151f;border:1px solid #242a3d;border-radius:14px;padding:20px;">
              <div aria-hidden="true" style="width:38px;height:38px;border-radius:10px;background:#171b28;border:1px solid #242a3d;display:flex;align-items:center;justify-content:center;color:#7c8bfa;margin-bottom:12px;">
                {%- case block.settings.icon -%}
                  {%- when 'swiss' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3.5" y="3.5" width="17" height="17" rx="3.5"></rect>
                      <path d="M12 8v8M8 12h8"></path>
                    </svg>
                  {%- when 'lock' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="5.5" y="11" width="13" height="9" rx="1.8"></rect>
                      <path d="M8 11V8a4 4 0 0 1 8 0v3"></path>
                    </svg>
                  {%- when 'link' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9.5 14.5 14.5 9.5"></path>
                      <path d="M11 6.5 12.6 4.9a3.2 3.2 0 0 1 4.5 4.5L15.5 11"></path>
                      <path d="M13 17.5 11.4 19.1a3.2 3.2 0 0 1-4.5-4.5L8.5 13"></path>
                    </svg>
                  {%- when 'chart' -%}
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M4 20V10M11 20V4M18 20v-7"></path>
                    </svg>
                {%- endcase -%}
              </div>
              <h3 style="margin:0 0 6px;font-size:16px;font-weight:600;">{{ block.settings.title | escape }}</h3>
              <p style="color:#8b93ab;margin:0;font-size:14px;line-height:1.6;">{{ block.settings.text | escape }}</p>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.cta_url != blank -%}
      <div style="text-align:center;margin-top:56px;">
        <a href="{{ section.settings.cta_url }}"
           style="display:inline-block;background:#4c56b0;color:#fff;text-decoration:none;font-weight:600;padding:13px 28px;border-radius:9px;font-size:15px;">
          {{ section.settings.cta_label | default: 'Tarife ansehen' | escape }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Wie es funktioniert",
  "settings": [
    { "type": "text", "id": "heading", "label": "Überschrift", "default": "Wie es funktioniert" },
    { "type": "textarea", "id": "subheading", "label": "Unterzeile", "default": "Was die Plattform ist, wie der Ablauf vom Kauf zum ersten Chat aussieht und warum es sie gibt — ohne Marketing-Umwege." },

    { "type": "text", "id": "was_heading", "label": "Was — Überschrift", "default": "Was ist das?" },
    { "type": "textarea", "id": "was_text", "label": "Was — Text", "default": "Eine Multi-Tenant-KI-Plattform: mehrere Sprachmodelle — Cloud-Anbieter wie Anthropic und OpenAI sowie mindestens ein lokales Modell — über ein einziges Gateway, dazu eigene Agenten mit festem System-Prompt für wiederkehrende Aufgaben und echte Integrationen (Slack, Notion, Google, GitHub, Shopify) per Login statt Copy-Paste von Schlüsseln. Jeder Kunde ist auf Datenbankebene strikt von anderen getrennt." },

    { "type": "text", "id": "wie_heading", "label": "Wie — Überschrift", "default": "Vom Kauf zum ersten Chat" },

    { "type": "text", "id": "warum_heading", "label": "Warum — Überschrift", "default": "Warum diese Plattform?" },

    { "type": "url", "id": "cta_url", "label": "Button-Link (optional)", "default": "/" },
    { "type": "text", "id": "cta_label", "label": "Button-Text", "default": "Tarife ansehen" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Ablaufschritt (Wie)",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel" },
        { "type": "textarea", "id": "text", "label": "Beschreibung" }
      ]
    },
    {
      "type": "value",
      "name": "Wert-Argument (Warum)",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "swiss", "label": "Schweiz" },
            { "value": "lock", "label": "Sicherheit" },
            { "value": "link", "label": "Integration" },
            { "value": "chart", "label": "Statistik" }
          ],
          "default": "swiss"
        },
        { "type": "text", "id": "title", "label": "Titel" },
        { "type": "textarea", "id": "text", "label": "Beschreibung" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Wie es funktioniert",
      "blocks": [
        { "type": "step", "settings": { "title": "Tarif wählen", "text": "Vom kostenlosen Free-Tarif bis Enterprise — alle Preise in CHF inklusive Mehrwertsteuer, monatlich kündbar." } },
        { "type": "step", "settings": { "title": "Automatisch angemeldet", "text": "Kein API-Key, kein manuelles Einrichten: der einzige Zugang ist E-Mail und Passwort, wie bei den großen Chat-Anbietern. Nach dem Kauf landest du direkt eingeloggt im Chat." } },
        { "type": "step", "settings": { "title": "Modell wählen", "text": "Im Chat das passende Modell auswählen — freigeschaltet nach Tarif, wahlweise Cloud oder ein lokales Modell." } },
        { "type": "step", "settings": { "title": "Chatten oder Agenten nutzen", "text": "Direkt loslegen mit Antworten in Echtzeit, oder einen eigenen Agenten mit festem System-Prompt für wiederkehrende Aufgaben anlegen. Integrationen wie Slack oder Notion lassen sich optional per Login verbinden." } },
        { "type": "value", "settings": { "icon": "swiss", "title": "Schweizer Preise, ehrlich", "text": "Alle Preise in CHF inklusive Mehrwertsteuer, jederzeit kündbar — keine versteckten Gebühren, kein Streichpreis-Theater." } },
        { "type": "value", "settings": { "icon": "lock", "title": "Echte Mandantentrennung", "text": "Jeder Kunde sieht ausschließlich seine eigenen Daten — durchgesetzt auf Datenbankebene (Row-Level-Security), nicht nur im Interface." } },
        { "type": "value", "settings": { "icon": "link", "title": "Keine Anbieter-Bindung", "text": "Mehrere Modelle über ein Gateway frei wählbar — kein eigenes Konto und kein eigener Schlüssel bei jedem einzelnen Anbieter nötig." } },
        { "type": "value", "settings": { "icon": "chart", "title": "Transparenter Verbrauch", "text": "Laufende Übersicht über verbrauchte Tokens pro Monat und pro Modell — keine Überraschung auf der Rechnung." } }
      ]
    }
  ]
}
{% endschema %}
