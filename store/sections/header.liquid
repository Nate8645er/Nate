<header style="border-bottom:1px solid #1a1f2e;background:rgba(7,8,13,0.8);backdrop-filter:blur(10px);position:sticky;top:0;z-index:10;">
  <div class="page-width" style="display:flex;align-items:center;gap:24px;padding:16px 20px;">
    <a href="/" style="display:flex;align-items:center;gap:10px;color:#eef0f7;text-decoration:none;">
      <span style="width:20px;height:20px;border-radius:6px;flex-shrink:0;background:linear-gradient(135deg,#7c8bfa,#3fe3c4);"></span>
      <span class="brand-font" style="font-weight:700;font-size:17px;letter-spacing:-0.01em;">
        {{ section.settings.logo_text | default: shop.name | escape }}
      </span>
    </a>
    <nav style="display:flex;gap:22px;margin-left:auto;align-items:center;">
      {%- for block in section.blocks -%}
        <a {{ block.shopify_attributes }}
           href="{{ block.settings.url }}"
           style="color:#8b93ab;text-decoration:none;font-size:14px;transition:color 160ms;">
          {{ block.settings.label | escape }}
        </a>
      {%- endfor -%}
      <a href="/cart" style="color:#eef0f7;text-decoration:none;font-size:14px;" aria-label="Warenkorb">
        Warenkorb{% if cart.item_count > 0 %} ({{ cart.item_count }}){% endif %}
      </a>
    </nav>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    { "type": "text", "id": "logo_text", "label": "Logo-Text", "default": "KI-Plattform" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Navigationslink",
      "settings": [
        { "type": "text", "id": "label", "label": "Beschriftung", "default": "Tarife" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 6
}
{% endschema %}
