# Copy to .env (which is gitignored) and fill in on YOUR machine only.
# Never commit the real file, never paste these values into a chat.
#
# Coinbase Advanced Trade API key: permissions View + Trade ONLY.
# A key with Transfer permission is refused by the connector.
COINBASE_API_KEY=
COINBASE_API_SECRET=
# UUID of the one portfolio the key belongs to (Coinbase > Portfolio).
HYPERGROK_PORTFOLIO_ID=
# Leave unset. Real orders additionally need this to be exactly 1.
# LIVE_TRADING_ENABLED=1
