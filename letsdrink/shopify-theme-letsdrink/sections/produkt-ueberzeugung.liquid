{%- comment -%}
  Section: Produkt-Überzeugung
  Für Let'sDrink. Gehört unter den Kaufbutton auf der Produktseite.
{%- endcomment -%}

<section
  class="pu reveal"
  id="pu-{{ section.id }}"
  aria-labelledby="pu-title-{{ section.id }}"
>
  <div class="pu__inner">

    {%- if section.settings.problem_title != blank -%}
      <div class="pu__block pu__problem">
        <p class="pu__eyebrow">{{ section.settings.problem_eyebrow }}</p>
        <h2 class="pu__h2" id="pu-title-{{ section.id }}">{{ section.settings.problem_title }}</h2>
        <div class="pu__rte">{{ section.settings.problem_text }}</div>
      </div>
    {%- endif -%}

    {%- assign step_blocks = section.blocks | where: "type", "step" -%}
    {%- if step_blocks.size > 0 -%}
      <div class="pu__block">
        <h3 class="pu__h3">{{ section.settings.steps_title }}</h3>
        <ol class="pu__steps">
          {%- for block in step_blocks -%}
            <li class="pu__step" {{ block.shopify_attributes }}>
              <span class="pu__step-num" aria-hidden="true">{{ forloop.index }}</span>
              <div>
                <p class="pu__step-title">{{ block.settings.title }}</p>
                <p class="pu__step-text">{{ block.settings.text }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    {%- endif -%}

    {%- comment -%} Der Unterschied-Block {%- endcomment -%}
    {%- if section.settings.filter_title != blank -%}
      <div class="pu__filter">
        <div class="pu__filter-copy">
          <p class="pu__eyebrow pu__eyebrow--light">{{ section.settings.filter_eyebrow }}</p>
          <h3 class="pu__h3 pu__h3--light">{{ section.settings.filter_title }}</h3>
          <div class="pu__rte pu__rte--light">{{ section.settings.filter_text }}</div>

          <ul class="pu__facts">
            {%- if section.settings.fact_1 != blank -%}<li>{{ section.settings.fact_1 }}</li>{%- endif -%}
            {%- if section.settings.fact_2 != blank -%}<li>{{ section.settings.fact_2 }}</li>{%- endif -%}
            {%- if section.settings.fact_3 != blank -%}<li>{{ section.settings.fact_3 }}</li>{%- endif -%}
          </ul>

          {%- if section.settings.filter_link != blank -%}
            <a class="pu__cta" href="{{ section.settings.filter_link }}">
              {{ section.settings.filter_link_label }}
            </a>
          {%- endif -%}
        </div>

        {%- if section.settings.filter_image != blank -%}
          <figure class="pu__filter-media">
            {{
              section.settings.filter_image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 750px) 42vw, 92vw',
                widths: '400, 600, 900',
                alt: section.settings.filter_image_alt
            }}
            {%- if section.settings.filter_caption != blank -%}
              <figcaption>{{ section.settings.filter_caption }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign faq_blocks = section.blocks | where: "type", "faq" -%}
    {%- if faq_blocks.size > 0 -%}
      <div class="pu__block">
        <h3 class="pu__h3">{{ section.settings.faq_title }}</h3>
        <div class="pu__faq">
          {%- for block in faq_blocks -%}
            <details class="pu__faq-item" {{ block.shopify_attributes }}>
              <summary class="pu__faq-q">
                <span>{{ block.settings.question }}</span>
                <span class="pu__faq-icon" aria-hidden="true"></span>
              </summary>
              <div class="pu__faq-a">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="pu__note">{{ section.settings.note }}</p>
    {%- endif -%}

  </div>
</section>

<style>
  #pu-{{ section.id }} {
    --pu-ink: {{ section.settings.color_ink }};
    --pu-surface: {{ section.settings.color_surface }};
    --pu-deep: {{ section.settings.color_deep }};
    --pu-accent: {{ section.settings.color_accent }};
    --pu-muted: {{ section.settings.color_ink }}99;
    --pu-line: {{ section.settings.color_ink }}22;

    background: var(--pu-surface);
    color: var(--pu-ink);
    padding: 48px 0;
  }

  #pu-{{ section.id }} .pu__inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #pu-{{ section.id }} .pu__block { margin-bottom: 44px; }
  #pu-{{ section.id }} .pu__block:last-child { margin-bottom: 0; }

  #pu-{{ section.id }} .pu__eyebrow {
    font-family: Inter, system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--pu-accent);
    margin: 0 0 10px;
  }
  #pu-{{ section.id }} .pu__eyebrow--light { color: var(--pu-accent); }

  #pu-{{ section.id }} .pu__h2,
  #pu-{{ section.id }} .pu__h3 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    line-height: 1.15;
    text-wrap: balance;
    margin: 0 0 14px;
  }
  #pu-{{ section.id }} .pu__h2 { font-size: clamp(26px, 5vw, 38px); }
  #pu-{{ section.id }} .pu__h3 { font-size: clamp(21px, 3.6vw, 28px); }
  #pu-{{ section.id }} .pu__h3--light { color: #fff; }

  #pu-{{ section.id }} .pu__rte {
    font-family: Inter, system-ui, sans-serif;
    font-size: 16.5px;
    line-height: 1.6;
    max-width: 62ch;
  }
  #pu-{{ section.id }} .pu__rte p { margin: 0 0 12px; }
  #pu-{{ section.id }} .pu__rte p:last-child { margin-bottom: 0; }
  #pu-{{ section.id }} .pu__rte--light { color: #ffffffdd; }

  /* Schritte */
  #pu-{{ section.id }} .pu__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  #pu-{{ section.id }} .pu__step {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 14px;
    align-items: start;
  }
  #pu-{{ section.id }} .pu__step-num {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 22px;
    color: var(--pu-accent);
    line-height: 1.2;
  }
  #pu-{{ section.id }} .pu__step-title {
    font-family: Inter, system-ui, sans-serif;
    font-weight: 600;
    font-size: 16.5px;
    margin: 0 0 3px;
  }
  #pu-{{ section.id }} .pu__step-text {
    font-family: Inter, system-ui, sans-serif;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--pu-muted);
    margin: 0;
  }

  /* Unterschied-Block */
  #pu-{{ section.id }} .pu__filter {
    background: var(--pu-deep);
    border-radius: 4px;
    padding: 28px 22px;
    display: grid;
    gap: 24px;
    margin-bottom: 44px;
  }
  #pu-{{ section.id }} .pu__facts {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    font-family: Inter, system-ui, sans-serif;
    font-size: 15.5px;
    color: #ffffffdd;
  }
  #pu-{{ section.id }} .pu__facts li {
    padding-left: 20px;
    position: relative;
    margin-bottom: 9px;
  }
  #pu-{{ section.id }} .pu__facts li::before {
    content: "";
    position: absolute;
    left: 0;
    top: .68em;
    width: 9px;
    height: 2px;
    background: var(--pu-accent);
  }
  #pu-{{ section.id }} .pu__filter-media { margin: 0; }
  #pu-{{ section.id }} .pu__filter-media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 3px;
  }
  #pu-{{ section.id }} .pu__filter-media figcaption {
    font-family: Inter, system-ui, sans-serif;
    font-size: 13px;
    color: #ffffffaa;
    margin-top: 9px;
  }

  #pu-{{ section.id }} .pu__cta {
    display: inline-block;
    margin-top: 22px;
    background: var(--pu-accent);
    color: #0c211f;
    font-family: Inter, system-ui, sans-serif;
    font-weight: 600;
    font-size: 15.5px;
    text-decoration: none;
    padding: 14px 26px;
    border-radius: 3px;
    min-height: 44px;
    transition: filter .16s ease, transform .16s ease;
  }
  #pu-{{ section.id }} .pu__cta:hover { filter: brightness(1.08); transform: translateY(-1px); }
  #pu-{{ section.id }} .pu__cta:active { transform: translateY(0); }
  #pu-{{ section.id }} .pu__cta:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  /* FAQ */
  #pu-{{ section.id }} .pu__faq { border-top: 1px solid var(--pu-line); }
  #pu-{{ section.id }} .pu__faq-item { border-bottom: 1px solid var(--pu-line); }
  #pu-{{ section.id }} .pu__faq-q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    list-style: none;
    padding: 16px 0;
    min-height: 44px;
    font-family: Inter, system-ui, sans-serif;
    font-weight: 600;
    font-size: 16px;
  }
  #pu-{{ section.id }} .pu__faq-q::-webkit-details-marker { display: none; }
  #pu-{{ section.id }} .pu__faq-q:focus-visible {
    outline: 3px solid var(--pu-accent);
    outline-offset: 2px;
  }
  #pu-{{ section.id }} .pu__faq-icon {
    flex: none;
    width: 14px;
    height: 14px;
    position: relative;
  }
  #pu-{{ section.id }} .pu__faq-icon::before,
  #pu-{{ section.id }} .pu__faq-icon::after {
    content: "";
    position: absolute;
    background: var(--pu-accent);
    transition: transform .18s ease;
  }
  #pu-{{ section.id }} .pu__faq-icon::before { inset: 6px 0 auto 0; height: 2px; }
  #pu-{{ section.id }} .pu__faq-icon::after { inset: 0 auto 0 6px; width: 2px; }
  #pu-{{ section.id }} .pu__faq-item[open] .pu__faq-icon::after { transform: scaleY(0); }
  #pu-{{ section.id }} .pu__faq-a {
    font-family: Inter, system-ui, sans-serif;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--pu-muted);
    padding: 0 0 18px;
    max-width: 62ch;
  }

  #pu-{{ section.id }} .pu__note {
    font-family: Inter, system-ui, sans-serif;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--pu-muted);
    border-left: 2px solid var(--pu-line);
    padding-left: 14px;
    max-width: 62ch;
    margin: 0;
  }

  @media (min-width: 750px) {
    #pu-{{ section.id }} { padding: 72px 0; }
    #pu-{{ section.id }} .pu__filter {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: 40px 36px;
      gap: 36px;
    }
    #pu-{{ section.id }} .pu__steps {
      grid-template-columns: repeat({{ step_blocks.size | at_most: 3 }}, 1fr);
      gap: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #pu-{{ section.id }} * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

{% schema %}
{
  "name": "Produkt-Überzeugung",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Farben" },
    { "type": "color", "id": "color_surface", "label": "Hintergrund", "default": "#F6F3EC" },
    { "type": "color", "id": "color_ink", "label": "Text", "default": "#1B2A24" },
    { "type": "color", "id": "color_deep", "label": "Fläche Unterschied-Block", "default": "#173F3C" },
    { "type": "color", "id": "color_accent", "label": "Akzent", "default": "#2E9C93" },

    { "type": "header", "content": "Problem" },
    { "type": "text", "id": "problem_eyebrow", "label": "Kleine Zeile", "default": "Kennst du das" },
    { "type": "text", "id": "problem_title", "label": "Titel", "default": "Du formst die Hand, und die Hälfte läuft daneben." },
    {
      "type": "richtext",
      "id": "problem_text",
      "label": "Text",
      "default": "<p>Und trinken tut er trotzdem nicht richtig, weil er aus einer Handfläche nicht schlecken kann. Also nimmst du beim nächsten Mal doch die Schüssel mit, und dann ist der Rucksack nass.</p>"
    },

    { "type": "header", "content": "So läuft es" },
    { "type": "text", "id": "steps_title", "label": "Titel", "default": "In drei Schritten" },

    { "type": "header", "content": "Der Unterschied" },
    { "type": "text", "id": "filter_eyebrow", "label": "Kleine Zeile", "default": "Der Unterschied" },
    { "type": "text", "id": "filter_title", "label": "Titel", "default": "Das Wasser läuft zurück." },
    {
      "type": "richtext",
      "id": "filter_text",
      "label": "Text",
      "default": "<p>Bei den meisten Flaschen kippst du den Rest weg, weil du ihn nicht zurückbekommst. Hier richtest du die Flasche auf und alles fliesst zurück. Auf einer langen Runde ist das der Unterschied zwischen zwei Portionen und fünf.</p>"
    },
    { "type": "text", "id": "fact_1", "label": "Fakt 1", "default": "550 ml, reicht für mehrere Portionen" },
    { "type": "text", "id": "fact_2", "label": "Fakt 2", "default": "Verschlossen auslaufsicher, auch quer im Rucksack" },
    { "type": "text", "id": "fact_3", "label": "Fakt 3", "default": "Passt in den Seitenhalter jedes Rucksacks" },
    { "type": "image_picker", "id": "filter_image", "label": "Bild" },
    { "type": "text", "id": "filter_image_alt", "label": "Alt-Text", "default": "Trinkflasche mit Napf im Einsatz" },
    { "type": "text", "id": "filter_caption", "label": "Bildunterschrift", "default": "" },
    { "type": "url", "id": "filter_link", "label": "Link" },
    { "type": "text", "id": "filter_link_label", "label": "Button-Text", "default": "" },

    { "type": "header", "content": "Fragen" },
    { "type": "text", "id": "faq_title", "label": "Titel", "default": "Was Kundinnen und Kunden vorher wissen wollen" },

    { "type": "header", "content": "Hinweis" },
    {
      "type": "text",
      "id": "note",
      "label": "Hinweiszeile",
      "default": "Wir machen keine gesundheitlichen Versprechen."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Knopf drücken" },
        { "type": "text", "id": "text", "label": "Text", "default": "Wasser läuft in den angebauten Napf. Eine Hand reicht, die Leine bleibt in der anderen." }
      ]
    },
    {
      "type": "faq",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage", "default": "Läuft sie im Rucksack aus?" },
        { "type": "richtext", "id": "answer", "label": "Antwort", "default": "<p>Verschlossen nicht. Genau dafür ist der Verschluss da. Wenn sie bei dir doch ausläuft, ist das ein Reklamationsfall und du bekommst Ersatz oder Geld zurück.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Produkt-Überzeugung",
      "blocks": [
        { "type": "step", "settings": { "title": "Knopf drücken", "text": "Wasser läuft in den angebauten Napf. Eine Hand reicht, die Leine bleibt in der anderen." } },
        { "type": "step", "settings": { "title": "Trinken lassen", "text": "Der Napf ist flach und breit genug, dass er ihn nicht umstösst." } },
        { "type": "step", "settings": { "title": "Aufrichten", "text": "Was übrig ist, läuft zurück in die Flasche. Nichts wird weggekippt." } },
        { "type": "faq", "settings": { "question": "Läuft sie im Rucksack aus?", "answer": "<p>Verschlossen nicht. Genau dafür ist der Verschluss da, und es ist der Punkt, an dem die meisten billigen Flaschen scheitern. Wenn sie bei dir doch ausläuft, ist das ein Reklamationsfall und du bekommst Ersatz oder Geld zurück.</p>" } },
        { "type": "faq", "settings": { "question": "Wie viel passt rein?", "answer": "<p>550 ml. Für eine normale Runde reicht das mehrfach, weil der Rest zurückläuft.</p>" } },
        { "type": "faq", "settings": { "question": "Funktioniert das auch bei kleinen Hunden?", "answer": "<p>Ja. Der Napf ist flach, auch ein Chihuahua kommt ran. Bei sehr grossen Hunden brauchst du für eine lange Wanderung eher zwei.</p>" } },
        { "type": "faq", "settings": { "question": "Geht das auch für Katzen?", "answer": "<p>Ja, für Katzen, die mitfahren oder an der Leine laufen. Der Napf ist niedrig genug.</p>" } }
      ]
    }
  ]
}
{% endschema %}
