<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#F6F3EC">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>
      {{ page_title }}{% if current_tags %} &ndash; {{ current_tags | join: ', ' }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
    </title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    {%- assign og_title = page_title | default: shop.name -%}
    {%- assign og_desc = page_description | default: shop.description | default: 'Trinkflasche mit angebautem Napf, 550 ml, für Hund und Katze.' -%}
    <meta property="og:type" content="{% if template contains 'product' %}product{% else %}website{% endif %}">
    <meta property="og:site_name" content="{{ shop.name | escape }}">
    <meta property="og:title" content="{{ og_title | escape }}">
    <meta property="og:description" content="{{ og_desc | escape }}">
    <meta property="og:url" content="{{ canonical_url }}">
    {%- if template contains 'product' and product.featured_image -%}
      <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
    {%- endif -%}
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ og_title | escape }}">
    <meta name="twitter:description" content="{{ og_desc | escape }}">

    {%- if template == 'index' -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | default: canonical_url | json }},
      "description": {{ og_desc | json }}
    }
    </script>
    {%- endif -%}

    {{ content_for_header }}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@400;500;600;700&display=swap">
    {{ 'theme.css' | asset_url | stylesheet_tag }}
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>
  <body class="tpl-{{ template | replace: '.', '-' | handle }}">
    <header class="hd">
      <input type="checkbox" id="nav-toggle" class="nav-toggle" hidden>
      <div class="wrap hd-in">
        <a href="{{ routes.root_url }}" class="hd-logo">{{ shop.name | default: "Let'sDrink" }}</a>
        <label for="nav-toggle" class="nav-burger" aria-label="Menü öffnen und schliessen"><span></span><span></span><span></span></label>
        <nav class="hd-nav">
          <a href="{{ routes.root_url }}">Start</a>
          <a href="{{ routes.all_products_collection_url }}">Alle Produkte</a>
          <a href="{{ routes.root_url }}pages/versand-und-rueckgabe">Versand &amp; Rückgabe</a>
          <a href="{{ routes.root_url }}pages/haeufige-fragen">Häufige Fragen</a>
          <a href="{{ routes.root_url }}pages/ueber-uns">Über uns</a>
          {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Konto</a>{% endif %}
        </nav>
        <a href="{{ routes.cart_url }}" class="hd-cart" aria-label="Warenkorb">
          Warenkorb
          {%- if cart.item_count > 0 -%}<span class="hd-cart-count">{{ cart.item_count }}</span>{%- endif -%}
        </a>
      </div>
    </header>

    <main id="main">{{ content_for_layout }}</main>

    <footer class="ft">
      <div class="wrap ft-grid">
        <div class="ft-brand">
          <p class="ft-logo">{{ shop.name | default: "Let'sDrink" }}</p>
          <p class="ft-tag">Trinkflasche mit angebautem Napf für Hund und Katze. Versand aus der Schweiz.</p>
        </div>
        <div class="ft-col">
          <h4>Shop</h4>
          <a href="{{ routes.all_products_collection_url }}">Alle Produkte</a>
          <a href="{{ routes.root_url }}pages/versand-und-rueckgabe">Versand &amp; Rückgabe</a>
          <a href="{{ routes.root_url }}pages/haeufige-fragen">Häufige Fragen</a>
        </div>
        <div class="ft-col">
          <h4>Über uns</h4>
          <a href="{{ routes.root_url }}pages/ueber-uns">Über uns</a>
          <a href="{{ routes.root_url }}pages/kontakt">Kontakt</a>
          {% if shop.customer_accounts_enabled %}<a href="{{ routes.account_url }}">Mein Konto</a>{% endif %}
        </div>
        <div class="ft-col">
          <h4>Rechtliches</h4>
          <a href="{{ routes.root_url }}pages/impressum">Impressum</a>
          <a href="{{ routes.root_url }}pages/datenschutz">Datenschutz</a>
          <a href="{{ routes.root_url }}pages/agb">AGB</a>
        </div>
      </div>
      <div class="wrap ft-bar">
        <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
        <p class="ft-pay">Sichere Zahlung · Versand aus der Schweiz</p>
      </div>
    </footer>

    <div id="consent-bar" class="consent" role="dialog" aria-label="Cookie-Hinweis" hidden>
      <div class="wrap consent-in">
        <p>Wir verwenden nur technisch notwendige Cookies für den Betrieb des Shops. Mehr in unserer
          <a href="{{ routes.root_url }}pages/datenschutz">Datenschutzerklärung</a>.</p>
        <div class="consent-btns">
          <button type="button" class="btn btn-sm" data-consent="ok">Verstanden</button>
        </div>
      </div>
    </div>
  </body>
</html>
