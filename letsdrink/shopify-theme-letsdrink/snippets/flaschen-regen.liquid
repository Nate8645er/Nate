{% comment %}
  Flaschen-Regen: Mini-Flaschen in allen sechs Farben fallen dauerhaft
  durch den ganzen Shop, hinter dem Inhalt. Wird einmal im Layout gerendert.
{% endcomment %}
<div id="flaschen-regen" aria-hidden="true">
  {% assign farben = "#40c8c0,#6fcf97,#f2a0bd,#a9ada8,#3a3a35,#f4f1e8" | split: "," %}
  {% for i in (0..9) %}
    {% assign fi = i | modulo: 6 %}
    <span class="regen-flasche" style="left:{{ i | times: 10 | plus: 3 }}%;--rspeed:{{ i | modulo: 4 | times: 3 | plus: 9 }}s;animation-delay:-{{ i | times: 1.7 }}s">
      <svg viewBox="0 0 34 52" xmlns="http://www.w3.org/2000/svg" stroke="#17333b" stroke-width="3" stroke-linejoin="round" stroke-linecap="round">
        <rect x="4" y="18" width="26" height="30" rx="7" fill="#e9f6f8"/>
        <path d="M6 15C6 6 13 2 17 2C21 2 28 6 28 15Z" fill="{{ farben[fi] }}"/>
      </svg>
    </span>
  {% endfor %}
</div>
