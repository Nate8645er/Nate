{%- comment -%}
  Newsletter-Popup: erscheint einmal pro Sitzung (sessionStorage), nach 8
  Sekunden oder ab 60% Scroll-Tiefe. Nativ über Shopify-Customer-Formular.
{%- endcomment -%}
<div class="nl-popup-overlay" id="nl-popup-overlay" hidden role="dialog" aria-modal="true" aria-labelledby="nl-popup-title">
  <div class="nl-popup">
    <button type="button" class="nl-popup-close" data-nl-close aria-label="Schliessen">&times;</button>
    <h3 id="nl-popup-title">10% auf deine erste Bestellung</h3>
    <p>Melde dich an und bekomm den Code LETSDRINK10 direkt in dein Postfach.</p>
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {% if form.posted_successfully? %}
        <p class="form-success">Fast geschafft: schau in dein Postfach und bestätige die Anmeldung.</p>
      {% else %}
        <div class="newsletter-row">
          <label for="nl-popup-email" class="visually-hidden">E-Mail-Adresse</label>
          <input type="email" id="nl-popup-email" name="contact[email]" placeholder="deine@email.ch" required autocomplete="email">
          <button type="submit" class="btn">Anmelden</button>
        </div>
      {% endif %}
    {% endform %}
    <p class="newsletter-fine">Abmeldung jederzeit mit einem Klick. Kein Spam.</p>
  </div>
</div>
