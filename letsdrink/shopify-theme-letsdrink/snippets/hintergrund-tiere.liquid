{%- comment -%}
  Dekorative Hintergrund-Ebene: die sechs Flaschenfarben schweben leicht,
  dazwischen Pfotenabdrücke und Wassertropfen. Rein dekorativ (aria-hidden),
  liegt hinter dem Content, kein Einfluss auf Tab-Reihenfolge oder Layout.
  Nur auf breiten Bildschirmen sichtbar, unter prefers-reduced-motion aus.
{%- endcomment -%}
<div class="bg-critters" aria-hidden="true">
  <span class="bg-bottle bg-bottle--tuerkis" style="--bx:6%; --by:14%; --bd:7.5s; --bdelay:0s"></span>
  <span class="bg-bottle bg-bottle--gruen" style="--bx:88%; --by:10%; --bd:8.4s; --bdelay:.6s"></span>
  <span class="bg-bottle bg-bottle--rosa" style="--bx:92%; --by:62%; --bd:7s; --bdelay:1.2s"></span>
  <span class="bg-bottle bg-bottle--grau" style="--bx:4%; --by:70%; --bd:9s; --bdelay:.3s"></span>
  <span class="bg-bottle bg-bottle--schwarz" style="--bx:78%; --by:86%; --bd:7.8s; --bdelay:.9s"></span>
  <span class="bg-bottle bg-bottle--weiss" style="--bx:14%; --by:40%; --bd:8.8s; --bdelay:1.5s"></span>

  <svg class="bg-drip" style="--bx:6%; --by:14%" width="6" height="10" viewBox="0 0 6 10"><path d="M3 0C3 4 0 5 0 7a3 3 0 0 0 6 0c0-2-3-3-3-7z"/></svg>
  <svg class="bg-drip" style="--bx:88%; --by:10%; animation-delay:.9s" width="6" height="10" viewBox="0 0 6 10"><path d="M3 0C3 4 0 5 0 7a3 3 0 0 0 6 0c0-2-3-3-3-7z"/></svg>

  <span class="bg-paw" style="--bx:30%; --by:20%; --bd:9.5s"></span>
  <span class="bg-paw" style="--bx:64%; --by:76%; --bd:8.2s"></span>
</div>
