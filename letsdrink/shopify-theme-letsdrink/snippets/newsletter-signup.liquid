{%- comment -%}
  Newsletter-Anmeldung, nativ über Shopify Customer-Formular, keine App nötig.
  Setzt contact[tags]=newsletter und accepts_marketing, damit sich die
  Willkommens-Mail-Serie (siehe texte/email-flows.md) darauf triggern lässt.
{%- endcomment -%}
<section class="newsletter reveal">
  <div class="wrap newsletter-in">
    <h2>{{ section.settings.newsletter_title | default: "10% auf deine erste Bestellung" }}</h2>
    <p>{{ section.settings.newsletter_text | default: "Melde dich an und bekomm den Code LETSDRINK10 direkt in dein Postfach." }}</p>
    {% form 'customer' %}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {% if form.posted_successfully? %}
        <p class="form-success">Fast geschafft: schau in dein Postfach und bestätige die Anmeldung.</p>
      {% else %}
        <div class="newsletter-row">
          <label for="newsletter-email" class="visually-hidden">E-Mail-Adresse</label>
          <input type="email" id="newsletter-email" name="contact[email]" placeholder="deine@email.ch" required autocomplete="email">
          <button type="submit" class="btn">Anmelden</button>
        </div>
      {% endif %}
    {% endform %}
    <p class="newsletter-fine">Abmeldung jederzeit mit einem Klick. Kein Spam.</p>
  </div>
</section>
