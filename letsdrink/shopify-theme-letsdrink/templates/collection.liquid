<section class="collection">
  <div class="wrap">
    <h1>{{ collection.title }}</h1>
    {% if collection.description != blank %}
      <div class="rte collection-desc">{{ collection.description }}</div>
    {% endif %}

    {% if collection.products.size > 0 %}
      {% paginate collection.products by 24 %}
        <div class="grid-prod">
          {% for p in collection.products %}
            <a class="prod" href="{{ p.url }}">
              {% if p.featured_image %}<img src="{{ p.featured_image | image_url: width: 500 }}" alt="{{ p.title | escape }}">{% endif %}
              <strong>{{ p.title }}</strong>
              <div class="price">{{ p.price | money }}</div>
            </a>
          {% endfor %}
        </div>
        {% if paginate.pages > 1 %}
          <nav class="pagination">{{ paginate | default_pagination }}</nav>
        {% endif %}
      {% endpaginate %}
    {% else %}
      <p>Noch keine Produkte in dieser Kategorie.</p>
    {% endif %}
  </div>
</section>
