{% section 'startseite-brunnen' %}

{% assign featured = collections.all.products %}
{% if featured.size > 0 %}
<section class="home-grid">
  <div class="wrap">
    <h2>Alle <span class="grad">Produkte</span></h2>
    <div class="grid-prod">
      {% for p in featured limit: 8 %}
        <a class="prod" href="{{ p.url }}">
          {% if p.featured_image %}<img src="{{ p.featured_image | image_url: width: 500 }}" alt="{{ p.title | escape }}">{% endif %}
          <strong>{{ p.title }}</strong>
          <div class="price">{{ p.price | money }}</div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
