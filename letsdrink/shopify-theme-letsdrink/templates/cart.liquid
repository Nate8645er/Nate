<section class="cart-page">
  <div class="wrap">
    <h1>Warenkorb</h1>

    {% if cart.item_count == 0 %}
      <p>Dein Warenkorb ist leer.</p>
      <a class="btn" href="{{ routes.all_products_collection_url }}">Weiter einkaufen</a>
    {% else %}
      {% form 'cart', cart, class: 'cart-form' %}
        <table class="cart-table">
          <thead>
            <tr>
              <th>Produkt</th>
              <th>Menge</th>
              <th>Preis</th>
            </tr>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr>
                <td class="cart-item">
                  {% if item.image %}<img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}">{% endif %}
                  <div>
                    <a href="{{ item.url }}">{{ item.product.title }}</a>
                    {% unless item.variant.title == 'Default Title' %}<p class="cart-item-variant">{{ item.variant.title }}</p>{% endunless %}
                    {% if item.original_line_price != item.final_line_price %}
                      <p class="cart-item-deal">Rabatt angewendet</p>
                    {% endif %}
                  </div>
                </td>
                <td>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" class="cart-qty-input" data-line="{{ forloop.index }}">
                </td>
                <td>
                  {% if item.original_line_price != item.final_line_price %}
                    <s>{{ item.original_line_price | money }}</s>
                  {% endif %}
                  {{ item.final_line_price | money }}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <div class="cart-summary">
          {% if cart.total_discount > 0 %}
            <p class="cart-discount">Rabatt: -{{ cart.total_discount | money }}</p>
          {% endif %}
          <p class="cart-total">Total: {{ cart.total_price | money }}</p>
          <p class="cart-note">inkl. MwSt, Gratisversand ab CHF 29.90</p>
          <button type="submit" name="update" class="btn btn-ghost">Warenkorb aktualisieren</button>
          <button type="submit" name="checkout" class="btn pdp-add">Zur Kasse</button>
        </div>
      {% endform %}
    {% endif %}
  </div>
</section>
