<section class="search-page">
  {% render 'wasserblasen' %}
  <div class="container">
    <div class="section-head centered">
      <span class="eyebrow-sticker">Suche</span>
      <h1 class="section-title">Wonach schnüffelst du?</h1>
    </div>
    <form action="{{ routes.search_url }}" method="get" class="search-form" role="search">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Suchbegriff eingeben" aria-label="Suchbegriff">
      <button type="submit" class="btn btn-coral">Suchen</button>
    </form>

    {% if search.performed %}
      {% if search.results_count > 0 %}
        {% paginate search.results by 12 %}
          {% for item in search.results %}
            <div class="search-result">
              <a href="{{ item.url }}">{{ item.title }}</a>
              {% if item.price %}<p>{{ item.price | money }}</p>{% endif %}
            </div>
          {% endfor %}
          {% if paginate.pages > 1 %}
            <nav class="pagination" aria-label="Seiten">{{ paginate | default_pagination }}</nav>
          {% endif %}
        {% endpaginate %}
      {% else %}
        <p class="collection-empty">Nichts gefunden für „{{ search.terms }}“. Versuch es mit einem anderen Begriff.</p>
      {% endif %}
    {% endif %}
  </div>
</section>
