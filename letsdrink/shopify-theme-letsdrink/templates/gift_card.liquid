<section class="page">
  <div class="wrap page" style="text-align:center; padding:80px 20px;">
    <h1>Dein Geschenkgutschein</h1>
    <p class="pdp-price">{{ gift_card.balance | money }}</p>
    {% if gift_card.qr_identifier %}
      <div class="gift-card-qr">{{ gift_card | image_url: width: 250 | image_tag }}</div>
    {% endif %}
    <p>Code: <strong>{{ gift_card.code | format_code }}</strong></p>
  </div>
</section>
