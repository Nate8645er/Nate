<section class="page">
  <div class="wrap page">
    <h1>{{ page.title }}</h1>
    <div class="rte">{{ page.content }}</div>

    {% form 'contact' %}
      {% if form.posted_successfully? %}
        <p class="form-success">Danke, deine Nachricht ist angekommen. Wir antworten innerhalb eines Werktags.</p>
      {% endif %}
      {{ form.errors | default_errors }}

      <label for="contact-name">Name</label>
      <input type="text" id="contact-name" name="contact[name]" autocomplete="name">

      <label for="contact-email">E-Mail</label>
      <input type="email" id="contact-email" name="contact[email]" required autocomplete="email">

      <label for="contact-order">Bestellnummer (optional)</label>
      <input type="text" id="contact-order" name="contact[Bestellnummer]">

      <label for="contact-body">Nachricht</label>
      <textarea id="contact-body" name="contact[body]" rows="5" required></textarea>

      <button type="submit" class="btn">Nachricht senden</button>
    {% endform %}
  </div>
</section>
