<section class="page"><div class="wrap page">
  <h1>Neues Passwort setzen</h1>
  {% form 'reset_customer_password' %}
    {{ form.errors | default_errors }}
    <label for="password">Neues Passwort</label>
    <input type="password" name="customer[password]" id="password" required autocomplete="new-password">
    <label for="password_confirmation">Passwort bestätigen</label>
    <input type="password" name="customer[password_confirmation]" id="password_confirmation" required autocomplete="new-password">
    <button type="submit" class="btn">Passwort setzen</button>
  {% endform %}
</div></section>
