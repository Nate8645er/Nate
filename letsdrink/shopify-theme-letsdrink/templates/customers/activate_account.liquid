<section class="page"><div class="wrap page">
  <h1>Konto aktivieren</h1>
  {% form 'activate_customer_password' %}
    {{ form.errors | default_errors }}
    <label for="customer_password">Passwort</label>
    <input type="password" name="customer[password]" id="customer_password" required autocomplete="new-password">
    <label for="customer_password_confirmation">Passwort bestätigen</label>
    <input type="password" name="customer[password_confirmation]" id="customer_password_confirmation" required autocomplete="new-password">
    <button type="submit" class="btn">Konto aktivieren</button>
  {% endform %}
</div></section>
