<section class="page"><div class="wrap page">
  <h1>Mein Konto</h1>
  <p><a href="{{ routes.account_logout_url }}">Abmelden</a> · <a href="{{ routes.account_addresses_url }}">Adressen</a></p>
  <h2>Bestellungen</h2>
  {% if customer.orders.size > 0 %}
    <table class="cart-table">
      <thead><tr><th>Bestellung</th><th>Datum</th><th>Bezahlstatus</th><th>Total</th></tr></thead>
      <tbody>
        {% for order in customer.orders %}
          <tr>
            <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
            <td>{{ order.created_at | date: '%d.%m.%Y' }}</td>
            <td>{{ order.financial_status_label }}</td>
            <td>{{ order.total_price | money }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  {% else %}
    <p>Noch keine Bestellungen.</p>
  {% endif %}
</div></section>
