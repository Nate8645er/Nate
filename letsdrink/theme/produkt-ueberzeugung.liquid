{%- comment -%}
  Section: Produkt-Überzeugung (Trinkbrunnen + Filter-Abo)
  Für MeowUfo. Gehört unter den Kaufbutton auf der Produktseite.

  Deploy: NUR ins Draft-Theme "Haustier 2" (ID 195184951673).
  Das Live-Theme "haustiere" (195081601401) ist per API nicht beschreibbar.
  Upload via themeFilesUpsert, Content base64-kodiert.

  Design folgt dem bestehenden Store: Playfair Display für Headlines,
  Inter für Body, Dunkelgrün als Fläche, warmes Orange als einziger Akzent.
  Farben sind Settings, damit du sie im Theme-Editor exakt an den Store
  anpassen kannst, ohne den Code anzufassen.
{%- endcomment -%}

<section
  class="pu"
  id="pu-{{ section.id }}"
  aria-labelledby="pu-title-{{ section.id }}"
>
  <div class="pu__inner">

    {%- if section.settings.problem_title != blank -%}
      <div class="pu__block pu__problem">
        <p class="pu__eyebrow">{{ section.settings.problem_eyebrow }}</p>
        <h2 class="pu__h2" id="pu-title-{{ section.id }}">{{ section.settings.problem_title }}</h2>
        <div class="pu__rte">{{ section.settings.problem_text }}</div>
      </div>
    {%- endif -%}

    {%- assign step_blocks = section.blocks | where: "type", "step" -%}
    {%- if step_blocks.size > 0 -%}
      <div class="pu__block">
        <h3 class="pu__h3">{{ section.settings.steps_title }}</h3>
        <ol class="pu__steps">
          {%- for block in step_blocks -%}
            <li class="pu__step" {{ block.shopify_attributes }}>
              <span class="pu__step-num" aria-hidden="true">{{ forloop.index }}</span>
              <div>
                <p class="pu__step-title">{{ block.settings.title }}</p>
                <p class="pu__step-text">{{ block.settings.text }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ol>
      </div>
    {%- endif -%}

    {%- comment -%} Der Filter-Block. Das ist das Herz der Seite. {%- endcomment -%}
    {%- if section.settings.filter_title != blank -%}
      <div class="pu__filter">
        <div class="pu__filter-copy">
          <p class="pu__eyebrow pu__eyebrow--light">{{ section.settings.filter_eyebrow }}</p>
          <h3 class="pu__h3 pu__h3--light">{{ section.settings.filter_title }}</h3>
          <div class="pu__rte pu__rte--light">{{ section.settings.filter_text }}</div>

          <ul class="pu__facts">
            {%- if section.settings.fact_1 != blank -%}<li>{{ section.settings.fact_1 }}</li>{%- endif -%}
            {%- if section.settings.fact_2 != blank -%}<li>{{ section.settings.fact_2 }}</li>{%- endif -%}
            {%- if section.settings.fact_3 != blank -%}<li>{{ section.settings.fact_3 }}</li>{%- endif -%}
          </ul>

          {%- if section.settings.filter_link != blank -%}
            <a class="pu__cta" href="{{ section.settings.filter_link }}">
              {{ section.settings.filter_link_label }}
            </a>
          {%- endif -%}
        </div>

        {%- if section.settings.filter_image != blank -%}
          <figure class="pu__filter-media">
            {{
              section.settings.filter_image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                sizes: '(min-width: 750px) 42vw, 92vw',
                widths: '400, 600, 900',
                alt: section.settings.filter_image_alt
            }}
            {%- if section.settings.filter_caption != blank -%}
              <figcaption>{{ section.settings.filter_caption }}</figcaption>
            {%- endif -%}
          </figure>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- assign faq_blocks = section.blocks | where: "type", "faq" -%}
    {%- if faq_blocks.size > 0 -%}
      <div class="pu__block">
        <h3 class="pu__h3">{{ section.settings.faq_title }}</h3>
        <div class="pu__faq">
          {%- for block in faq_blocks -%}
            <details class="pu__faq-item" {{ block.shopify_attributes }}>
              <summary class="pu__faq-q">
                <span>{{ block.settings.question }}</span>
                <span class="pu__faq-icon" aria-hidden="true"></span>
              </summary>
              <div class="pu__faq-a">{{ block.settings.answer }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.note != blank -%}
      <p class="pu__note">{{ section.settings.note }}</p>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
{% endstylesheet %}

<style>
  #pu-{{ section.id }} {
    --pu-ink: {{ section.settings.color_ink }};
    --pu-surface: {{ section.settings.color_surface }};
    --pu-deep: {{ section.settings.color_deep }};
    --pu-accent: {{ section.settings.color_accent }};
    --pu-muted: {{ section.settings.color_ink }}99;
    --pu-line: {{ section.settings.color_ink }}22;

    background: var(--pu-surface);
    color: var(--pu-ink);
    padding: 48px 0;
  }

  #pu-{{ section.id }} .pu__inner {
    max-width: 1040px;
    margin: 0 auto;
    padding: 0 20px;
  }

  #pu-{{ section.id }} .pu__block { margin-bottom: 44px; }
  #pu-{{ section.id }} .pu__block:last-child { margin-bottom: 0; }

  #pu-{{ section.id }} .pu__eyebrow {
    font-family: Inter, system-ui, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: .16em;
    text-transform: uppercase;
    color: var(--pu-accent);
    margin: 0 0 10px;
  }
  #pu-{{ section.id }} .pu__eyebrow--light { color: var(--pu-accent); }

  #pu-{{ section.id }} .pu__h2,
  #pu-{{ section.id }} .pu__h3 {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 600;
    line-height: 1.15;
    text-wrap: balance;
    margin: 0 0 14px;
  }
  #pu-{{ section.id }} .pu__h2 { font-size: clamp(26px, 5vw, 38px); }
  #pu-{{ section.id }} .pu__h3 { font-size: clamp(21px, 3.6vw, 28px); }
  #pu-{{ section.id }} .pu__h3--light { color: #fff; }

  #pu-{{ section.id }} .pu__rte {
    font-family: Inter, system-ui, sans-serif;
    font-size: 16.5px;
    line-height: 1.6;
    max-width: 62ch;
  }
  #pu-{{ section.id }} .pu__rte p { margin: 0 0 12px; }
  #pu-{{ section.id }} .pu__rte p:last-child { margin-bottom: 0; }
  #pu-{{ section.id }} .pu__rte--light { color: #ffffffdd; }

  /* Schritte */
  #pu-{{ section.id }} .pu__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  #pu-{{ section.id }} .pu__step {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 14px;
    align-items: start;
  }
  #pu-{{ section.id }} .pu__step-num {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 22px;
    color: var(--pu-accent);
    line-height: 1.2;
  }
  #pu-{{ section.id }} .pu__step-title {
    font-family: Inter, system-ui, sans-serif;
    font-weight: 600;
    font-size: 16.5px;
    margin: 0 0 3px;
  }
  #pu-{{ section.id }} .pu__step-text {
    font-family: Inter, system-ui, sans-serif;
    font-size: 15.5px;
    line-height: 1.55;
    color: var(--pu-muted);
    margin: 0;
  }

  /* Filter-Block */
  #pu-{{ section.id }} .pu__filter {
    background: var(--pu-deep);
    border-radius: 4px;
    padding: 28px 22px;
    display: grid;
    gap: 24px;
    margin-bottom: 44px;
  }
  #pu-{{ section.id }} .pu__facts {
    list-style: none;
    margin: 18px 0 0;
    padding: 0;
    font-family: Inter, system-ui, sans-serif;
    font-size: 15.5px;
    color: #ffffffdd;
  }
  #pu-{{ section.id }} .pu__facts li {
    padding-left: 20px;
    position: relative;
    margin-bottom: 9px;
  }
  #pu-{{ section.id }} .pu__facts li::before {
    content: "";
    position: absolute;
    left: 0;
    top: .68em;
    width: 9px;
    height: 2px;
    background: var(--pu-accent);
  }
  #pu-{{ section.id }} .pu__filter-media { margin: 0; }
  #pu-{{ section.id }} .pu__filter-media img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 3px;
  }
  #pu-{{ section.id }} .pu__filter-media figcaption {
    font-family: Inter, system-ui, sans-serif;
    font-size: 13px;
    color: #ffffffaa;
    margin-top: 9px;
  }

  #pu-{{ section.id }} .pu__cta {
    display: inline-block;
    margin-top: 22px;
    background: var(--pu-accent);
    color: #14201b;
    font-family: Inter, system-ui, sans-serif;
    font-weight: 600;
    font-size: 15.5px;
    text-decoration: none;
    padding: 14px 26px;
    border-radius: 3px;
    min-height: 44px;
    transition: filter .16s ease, transform .16s ease;
  }
  #pu-{{ section.id }} .pu__cta:hover { filter: brightness(1.08); transform: translateY(-1px); }
  #pu-{{ section.id }} .pu__cta:active { transform: translateY(0); }
  #pu-{{ section.id }} .pu__cta:focus-visible {
    outline: 3px solid #fff;
    outline-offset: 3px;
  }

  /* FAQ */
  #pu-{{ section.id }} .pu__faq { border-top: 1px solid var(--pu-line); }
  #pu-{{ section.id }} .pu__faq-item { border-bottom: 1px solid var(--pu-line); }
  #pu-{{ section.id }} .pu__faq-q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    cursor: pointer;
    list-style: none;
    padding: 16px 0;
    min-height: 44px;
    font-family: Inter, system-ui, sans-serif;
    font-weight: 600;
    font-size: 16px;
  }
  #pu-{{ section.id }} .pu__faq-q::-webkit-details-marker { display: none; }
  #pu-{{ section.id }} .pu__faq-q:focus-visible {
    outline: 3px solid var(--pu-accent);
    outline-offset: 2px;
  }
  #pu-{{ section.id }} .pu__faq-icon {
    flex: none;
    width: 14px;
    height: 14px;
    position: relative;
  }
  #pu-{{ section.id }} .pu__faq-icon::before,
  #pu-{{ section.id }} .pu__faq-icon::after {
    content: "";
    position: absolute;
    background: var(--pu-accent);
    transition: transform .18s ease;
  }
  #pu-{{ section.id }} .pu__faq-icon::before { inset: 6px 0 auto 0; height: 2px; }
  #pu-{{ section.id }} .pu__faq-icon::after { inset: 0 auto 0 6px; width: 2px; }
  #pu-{{ section.id }} .pu__faq-item[open] .pu__faq-icon::after { transform: scaleY(0); }
  #pu-{{ section.id }} .pu__faq-a {
    font-family: Inter, system-ui, sans-serif;
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--pu-muted);
    padding: 0 0 18px;
    max-width: 62ch;
  }

  #pu-{{ section.id }} .pu__note {
    font-family: Inter, system-ui, sans-serif;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--pu-muted);
    border-left: 2px solid var(--pu-line);
    padding-left: 14px;
    max-width: 62ch;
    margin: 0;
  }

  @media (min-width: 750px) {
    #pu-{{ section.id }} { padding: 72px 0; }
    #pu-{{ section.id }} .pu__filter {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: 40px 36px;
      gap: 36px;
    }
    #pu-{{ section.id }} .pu__steps {
      grid-template-columns: repeat({{ step_blocks.size | at_most: 3 }}, 1fr);
      gap: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #pu-{{ section.id }} * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

{% schema %}
{
  "name": "Produkt-Überzeugung",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Farben"
    },
    { "type": "color", "id": "color_surface", "label": "Hintergrund", "default": "#F7F5F0" },
    { "type": "color", "id": "color_ink", "label": "Text", "default": "#1B2A24" },
    { "type": "color", "id": "color_deep", "label": "Fläche Filter-Block", "default": "#1B3A30" },
    { "type": "color", "id": "color_accent", "label": "Akzent", "default": "#E08A45" },

    { "type": "header", "content": "Problem" },
    { "type": "text", "id": "problem_eyebrow", "label": "Kleine Zeile", "default": "Kennst du das" },
    { "type": "text", "id": "problem_title", "label": "Titel", "default": "Der Napf ist abends noch genauso voll wie morgens." },
    {
      "type": "richtext",
      "id": "problem_text",
      "label": "Text",
      "default": "<p>Trinken tut sie trotzdem. Nur heimlich, am Wasserhahn, in der Dusche oder aus der Giesskanne. Katzen bevorzugen bewegtes Wasser, weil stehendes in der Natur meistens das schlechtere ist.</p><p>Der Brunnen hält es in Bewegung, filtert Haare und Futterreste heraus und läuft leise genug fürs Schlafzimmer.</p>"
    },

    { "type": "header", "content": "So läuft es" },
    { "type": "text", "id": "steps_title", "label": "Titel", "default": "In drei Schritten aufgestellt" },

    { "type": "header", "content": "Filter-Block" },
    { "type": "text", "id": "filter_eyebrow", "label": "Kleine Zeile", "default": "Alle vier Wochen" },
    { "type": "text", "id": "filter_title", "label": "Titel", "default": "Der Filter ist der Teil, über den niemand spricht." },
    {
      "type": "richtext",
      "id": "filter_text",
      "label": "Text",
      "default": "<p>Was nach vier Wochen im Filter hängt, ist Fell, Futterrest und Kalk. Genau das, was sonst im Wasser deiner Katze wäre.</p><p>Ein 3er-Pack reicht ein Vierteljahr und kommt als Brief in den Briefkasten.</p>"
    },
    { "type": "text", "id": "fact_1", "label": "Fakt 1", "default": "3er-Pack CHF 14.90, reicht drei Monate" },
    { "type": "text", "id": "fact_2", "label": "Fakt 2", "default": "Im Abo 10% günstiger, alle drei Monate automatisch" },
    { "type": "text", "id": "fact_3", "label": "Fakt 3", "default": "Pausieren und kündigen mit einem Klick, ohne E-Mail an uns" },
    { "type": "image_picker", "id": "filter_image", "label": "Bild (echter Filter nach vier Wochen)" },
    { "type": "text", "id": "filter_image_alt", "label": "Alt-Text", "default": "Gebrauchter Filter nach vier Wochen im Einsatz" },
    { "type": "text", "id": "filter_caption", "label": "Bildunterschrift", "default": "Kein Werbebild. Vier Wochen, zwei Katzen." },
    { "type": "url", "id": "filter_link", "label": "Link zum Filter-Produkt" },
    { "type": "text", "id": "filter_link_label", "label": "Button-Text", "default": "Filter ansehen" },

    { "type": "header", "content": "Fragen" },
    { "type": "text", "id": "faq_title", "label": "Titel", "default": "Was Kundinnen vorher wissen wollen" },

    { "type": "header", "content": "Hinweis" },
    {
      "type": "text",
      "id": "note",
      "label": "Hinweiszeile",
      "default": "Wir machen keine gesundheitlichen Versprechen. Wenn deine Katze auffällig wenig oder plötzlich sehr viel trinkt, gehört das zum Tierarzt und nicht in einen Onlineshop."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Schritt",
      "settings": [
        { "type": "text", "id": "title", "label": "Titel", "default": "Nicht neben das Futter" },
        { "type": "text", "id": "text", "label": "Text", "default": "Zwei Meter Abstand reichen. Katzen trinken instinktiv nicht dort, wo sie fressen." }
      ]
    },
    {
      "type": "faq",
      "name": "Frage",
      "settings": [
        { "type": "text", "id": "question", "label": "Frage", "default": "Was, wenn meine Katze ihn nicht benutzt?" },
        { "type": "richtext", "id": "answer", "label": "Antwort", "default": "<p>Lass den alten Napf zwei bis drei Tage daneben stehen. Die meisten Katzen steigen in dieser Zeit um. Passiert nach einer Woche nichts, schreib uns, wir haben noch zwei Tricks. Und wenn es dann immer noch nicht klappt, nimmst du ihn zurück.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Produkt-Überzeugung",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "faq" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
